<section class="my-[100px] md:my-[180px]">
  <div class="my-3 p-2">
    <h1
      class="text-2xl text-center md:text-[46px] font-monteserrat font-medium mdl:text-4xl text-nowrap"
    >
      The blockchain for data
    </h1>
    <p class="text-[16px] md:text-[25px] text-[#9B9B9B] text-center mt-3">
      Flare is an EVM smart contract platform with two enshrined data
      acquisition protocols.
    </p>

