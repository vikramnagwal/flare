            <div class="flex flex-col items-center">
              {items.icon}
              <h2 class="text-2xl mt-3 font-medium">{items.title}</h2>
              <p class="text-xl mt-1 font-medium text-[#9B9B9B]">
                {items.subTitle}
              </p>
              <p class="px-4 text-center my-3 text-[#9B9B9B]">
